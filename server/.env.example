# ---------------------------------------------------------------------------
# База данных (Postgres — совпадает с provider в schema.prisma)
# Локально поднимается через `docker compose up -d postgres`.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://mishkin:mishkin_local@localhost:5432/mishkin?schema=public"
# Для пулеров (Neon/Supabase) — прямое подключение для миграций.
DIRECT_URL="postgresql://mishkin:mishkin_local@localhost:5432/mishkin?schema=public"

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
BOT_TOKEN="your_bot_token_from_botfather"
BOT_USERNAME="mishkin_candles_bot"
# Короткое имя Mini App из BotFather (если создавали) — нужно для прямых ссылок.
BOT_APP_NAME=""
ADMIN_IDS="123456789,987654321"
CHANNEL_ID="@mishkin_candles"
CHANNEL_URL="https://t.me/mishkin_candles"

# Публичный адрес фронтенда (Mini App) и бэкенда.
WEBAPP_URL="https://your-app.trycloudflare.com"
PUBLIC_URL="https://your-api.trycloudflare.com"

# Секрет для GET /api/setup-webhook — без него эндпоинт закрыт.
SETUP_SECRET=""
# secret_token вебхука Telegram: приходит в X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=""

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Оплата · ЮKassa
#
# Пока переменных ниже нет — работает ВСТРОЕННЫЙ ЭМУЛЯТОР оплаты:
# страница /api/payments/mock/:id, деньги не двигаются, сквозной поток
# «заказ → оплата → статус Оплачен» проверяется целиком.
#
# Реквизиты тестового магазина: ЛК ЮKassa → Интеграция → Ключи API.
# Ключ тестового магазина начинается на test_.
# ---------------------------------------------------------------------------
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# auto (по наличию ключей) | mock (всегда эмулятор) | real (всегда API)
YOOKASSA_MODE="auto"
# Ограничить способ оплаты, например sbp. Пусто — выбор на стороне ЮKassa.
YOOKASSA_PAYMENT_METHOD=""
# Чек по 54-ФЗ. У тестового магазина без кассы запрос с чеком отклоняется.
YOOKASSA_SEND_RECEIPT="false"
# Код НДС для чека: 1 = без НДС, 4 = 20%.
YOOKASSA_VAT_CODE="1"
# Проверять IP входящих уведомлений. false — только для локальной отладки.
YOOKASSA_WEBHOOK_CHECK_IP="true"

# ---------------------------------------------------------------------------
# Демонстрация
# ---------------------------------------------------------------------------
# true — разрешить работу без Telegram initData (показ магазина в браузере).
# В боевом режиме держать выключенным: иначе заказы можно создавать откуда угодно.
ALLOW_BROWSER_DEMO="false"
