{
  "name": "mishkin-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && tsc -p tsconfig.seed.json",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check": "node scripts/db-check.mjs",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:e2e": "node scripts/e2e-checkout.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "telegraf": "^4.16.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^24.13.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
