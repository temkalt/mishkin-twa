generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  firstName  String
  lastName   String?
  username   String?
  isAdmin    Boolean  @default(false)
  lastVisit  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([telegramId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String
  price       Int      // в копейках (2800₽ = 280000)
  category    String
  topNote     String   @default("")
  heartNote   String   @default("")
  baseNote    String   @default("")
  images      String   @default("[]") // JSON массив URL
  inStock     Boolean  @default(true)
  /// Остаток на складе в штуках. NULL — учёт не ведётся (товар всегда доступен,
  /// как было до появления склада). Число — списывается при создании заказа.
  stock       Int?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isFeatured])
}

model PromoCode {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String   // "PERCENT" | "FIXED"
  discountValue Int      // для PERCENT: 10 = 10%, для FIXED: 50000 = 500₽
  isActive      Boolean  @default(true)
  usageLimit    Int      @default(0) // 0 = безлимит
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([isActive])
}

model Order {
  id             Int      @id @default(autoincrement())
  telegramUserId BigInt
  userName       String
  userPhone      String   @default("")
  userCity       String   @default("")
  userAddress    String   @default("")
  userPostal     String   @default("")
  deliveryMethod String   @default("CDEK") // СДЭК, Почта России, Boxberry, Самовывоз
  deliveryPrice  Int      @default(0) // стоимость доставки в копейках
  trackNumber    String   @default("")
  comment        String   @default("")
  tgUsername     String?
  items          String   // JSON: [{ productId, name, price, qty }]
  itemsTotal     Int      @default(0) // сумма товаров до скидки, в копейках
  totalPrice     Int      // к оплате в копейках (товары − скидка + доставка)
  promoCode      String?
  discount       Int      @default(0) // скидка в копейках
  status         String   @default("NEW") // "NEW" | "CONFIRMED" | "SHIPPED" | "DONE" | "CANCELLED"

  /// Когда остаток по позициям заказа вернулся на склад (отмена заказа).
  /// NULL — товары всё ещё числятся за этим заказом. Защищает от двойного
  /// возврата, если статус «Отменён» выставят повторно.
  stockReturnedAt DateTime?

  // --- Оплата ---
  paymentType    String   @default("MANUAL") // "ONLINE" | "MANUAL"
  paymentStatus  String   @default("UNPAID") // "UNPAID" | "PENDING" | "PAID" | "CANCELED" | "REFUNDED"
  paymentId      String?  @unique // id платежа в ЮKassa
  paymentMethod  String   @default("") // bank_card, sbp, yoo_money…
  paidAt         DateTime?
  consentAt      DateTime? // согласие на обработку ПДн (152-ФЗ)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([telegramUserId])
  @@index([status])
  @@index([paymentStatus])
}

/// Журнал входящих уведомлений от ЮKassa — обеспечивает идемпотентность
/// (одно и то же событие приходит повторно при ретраях платёжного шлюза).
model PaymentEvent {
  id        Int      @id @default(autoincrement())
  eventKey  String   @unique // "<event>:<paymentId>:<status>"
  paymentId String
  event     String
  status    String
  amount    Int      @default(0) // в копейках
  payload   String   // сырое тело уведомления
  createdAt DateTime @default(now())

  @@index([paymentId])
}
